{
  "name": "neon-board",
  "private": true,
  "version": "1.3.7",
  "author": "Elbioh <elbioheditor>",
  "description": "Neon - Personal & Duo Kanban Routine Organizer for Elbioh & Didi",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win --dir",
    "electron:exe": "vite build && electron-builder --win nsis portable dir",
    "electron:publish": "vite build && electron-builder --win nsis -p always"
  },
  "build": {
    "appId": "com.elbioh.neon",
    "productName": "Neon",
    "publish": [
      {
        "provider": "github",
        "owner": "elbioheditor",
        "repo": "neon-board"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/neon-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Neon",
      "artifactName": "Neon-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "canvas-confetti": "^1.9.3",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
